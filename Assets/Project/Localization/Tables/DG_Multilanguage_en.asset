  - m_Id: 1338552327
    m_Localized: Attacks burn enemies for 6 damage per second over 2s.
    m_Metadata:
      m_Items: []
  - m_Id: 1338552328
    m_Localized: "Dragon Flame Slash \xB7 20s cooldown: a huge wave of fire ahead."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552329
    m_Localized: 25% chance on hit to chain lightning to 3 enemies.
    m_Metadata:
      m_Items: []
  - m_Id: 1338552330
    m_Localized: "Thunder Judgement \xB7 18s cooldown: 5 bolts strike the nearest
      enemies."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552331
    m_Localized: Grants +15% Attack Damage and +10% Attack Speed while held.
    m_Metadata:
      m_Items: []
  - m_Id: 1338552332
    m_Localized: "Rift Cut \xB7 15s cooldown: dash through enemies and slash twice."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552333
    m_Localized: Kills restore 4 Mana.
    m_Metadata:
      m_Items: []
  - m_Id: 1338552334
    m_Localized: Slashes burn enemies for 5 damage per second over 2s.
    m_Metadata:
      m_Items: []
  - m_Id: 1338552335
    m_Localized: Slashes slow enemies by 30% for 1s.
    m_Metadata:
      m_Items: []
  - m_Id: 1338552336
    m_Localized: "Frost Field \xB7 16s cooldown: freeze nearby enemies for 2s."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552337
    m_Localized: Grants +8% Crit chance and +10% Attack Damage while held.
    m_Metadata:
      m_Items: []
  - m_Id: 1338552338
    m_Localized: Drains life on hit, restoring 1 HP per 20 damage dealt.
    m_Metadata:
      m_Items: []
  - m_Id: 1338552339
    m_Localized: "Holy Light \xB7 25s cooldown: restore 2 HP."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552340
    m_Localized: Kills restore 5 Mana.
    m_Metadata:
      m_Items: []
  - m_Id: 1338552341
    m_Localized: Poisons for 4 damage per second over 3s.
    m_Metadata:
      m_Items: []
