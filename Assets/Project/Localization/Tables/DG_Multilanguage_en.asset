    m_Localized: "PASSIVE \xB7 ROLE"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358099
    m_Localized: "ACTIVE \xB7 USE IN RUN"
    m_Metadata:
      m_Items: []
