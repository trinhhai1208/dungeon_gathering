    m_Metadata:
      m_Items: []
  - m_Id: 1334358055
    m_Localized: "M\u0169 S\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358056
    m_Localized: "Gi\xE1p L\u1EEDa K\u1EF5 S\u0129"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358057
    m_Localized: "G\u0103ng Tay B\xF3ng \u0110\xEAm"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358058
    m_Localized: "Gi\xE0y Phong V\u0169"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358059
    m_Localized: "S\xE1ch C\u1ED5 Ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358060
    m_Localized: "Khi\xEAn Th\xE1nh"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358061
    m_Localized: "Gi\xE1p B\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358062
    m_Localized: "M\u0169 Ph\xE1p S\u01B0"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358063
    m_Localized: "M\u1EB7t N\u1EA1 B\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358064
    m_Localized: "G\u0103ng B\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358065
    m_Localized: "D\xE2y Chuy\u1EC1n Gi\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358066
    m_Localized: "Gi\xE0y \u0110\u1ECF"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358067
    m_Localized: "Nh\u1EABn V\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358068
    m_Localized: "B\xECnh M\xE1u"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358069
    m_Localized: "Ki\u1EBFm S\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358070
    m_Localized: "Ki\u1EBFm s\u1EAFt"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358071
    m_Localized: "Ki\u1EBFm B\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358072
    m_Localized: "Ki\u1EBFm \u0110en"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358073
    m_Localized: "Ki\u1EBFm G\u1ED7 M\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358074
    m_Localized: "Ki\u1EBFm Th\xE1nh"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358075
    m_Localized: "Ki\u1EBFm L\u1EEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358076
    m_Localized: "Ki\u1EBFm S\u1EA5m"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358077
    m_Localized: "Ki\u1EBFm H\u01B0 Kh\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358078
    m_Localized: "Ki\u1EBFm Ho\xE0ng Kim"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358079
    m_Localized: "Ki\u1EBFm Dung Nham"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358080
    m_Localized: "Ki\u1EBFm Gai R\u1EEBng"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358081
    m_Localized: "Ki\u1EBFm \u0110\u1ED9c"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358082
    m_Localized: "Ki\u1EBFm T\xEDm"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358083
    m_Localized: "Warrior: +10% s\xE1t th\u01B0\u01A1ng \u0111\xF2n \u0111\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358084
    m_Localized: "Khi b\u1ECB v\u1EE1 gi\xE1p, ph\xE1t n\u1ED5 v\xF2ng l\u1EEDa g\xE2y
      s\xE1t th\u01B0\u01A1ng v\xE0 \u0111\u1EA9y l\xF9i qu\xE1i xung quanh."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358085
    m_Localized: "\u0110\xF2n ch\xED m\u1EA1ng h\u1ED3i ngay 2 Mana v\xE0 +20% t\u1ED1c
      ch\u1EA1y trong 1.5s."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358086
    m_Localized: "\u0110\u1EE9ng y\xEAn 1s: \u0111\xF2n b\u1EAFn ti\u1EBFp theo xuy\xEAn
      th\u1EA5u v\xE0 +40% s\xE1t th\u01B0\u01A1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358087
    m_Localized: "M\u1ED7i \u0111\xF2n \u0111\xE1nh th\u1EE9 3 tri\u1EC7u h\u1ED3i
      v\xF2ng xo\xE1y ph\xE9p t\u1EA1i v\u1ECB tr\xED m\u1EE5c ti\xEAu."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358088
    m_Localized: "B\xE3o Ph\xE9p \xB7 h\u1ED3i 20s: v\xF2ng xo\xE1y ph\xE9p l\u1EDBn
      quanh ng\u01B0\u1EDDi 3s."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358089
    m_Localized: "Warrior: +2 Gi\xE1p v\xE0 +1 M\xE1u t\u1ED1i \u0111a."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358090
    m_Localized: "Gi\u01A1 Khi\xEAn \xB7 h\u1ED3i 18s: mi\u1EC5n m\u1ECDi s\xE1t
      th\u01B0\u01A1ng trong 2s."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358091
    m_Localized: "Kh\xF4ng c\xF3 hi\u1EC7u \u1EE9ng Role."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358092
    m_Localized: "Mage: +20 Mana t\u1ED1i \u0111a v\xE0 +10% T\u1ED1c \u0111\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358093
    m_Localized: "Assassin: +12% Ch\xED m\u1EA1ng v\xE0 +15% S\xE1t th\u01B0\u01A1ng."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358094
    m_Localized: "Warrior: +1 Gi\xE1p t\u1ED1i \u0111a v\xE0 +10% T\u1ED1c \u0111\xE1nh."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358095
    m_Localized: "Ranger: +10% Ch\xED m\u1EA1ng v\xE0 +10% T\u1ED1c ch\u1EA1y."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358096
    m_Localized: "T\xDAI \u0110\u1ED2 & TRANG B\u1ECA"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358097
    m_Localized: "CH\u1EC8 S\u1ED0 C\u1ED8NG TH\u1EB2NG \xB7 M\u1ECCI ROLE"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358098
    m_Localized: "B\u1ECA \u0110\u1ED8NG \xB7 ROLE"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358099
    m_Localized: "CH\u1EE6 \u0110\u1ED8NG \xB7 K\xCDCH HO\u1EA0T TRONG TR\u1EACN"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358100
    m_Localized: "Ch\u1ECDn m\u1ED9t m\xF3n trong t\xFAi ho\u1EB7c m\u1ED9t \xF4
      \u0111ang m\u1EB7c \u0111\u1EC3 xem chi ti\u1EBFt."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358101
    m_Localized: "m\xF3n \xB7 nh\u1EB7t trong dungeon, ch\u1EC9 thay \u1EDF s\u1EA3nh"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358102
    m_Localized: "\u0110ANG M\u1EB6C"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358103
    m_Localized: "S\u1EBD thay "
    m_Metadata:
      m_Items: []
  - m_Id: 1334358104
    m_Localized: " \u0111ang tr\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358105
    m_Localized: "\xD4 "
    m_Metadata:
      m_Items: []
  - m_Id: 1334358106
    m_Localized: "KH\xD4NG C\xD3"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358107
    m_Localized: "K\xCDCH HO\u1EA0T"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358108
    m_Localized: "C\u1EA6N "
    m_Metadata:
      m_Items: []
  - m_Id: 1334358109
    m_Localized: "\u0110\xE3 \u0111\u1EE7 2 m\xF3n c\xF3 k\u1EF9 n\u0103ng k\xEDch
      ho\u1EA1t. Th\xE1o m\u1ED9t m\xF3n tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 1334358110
    m_Localized: "Mang 2 v\u0169 kh\xED \xB7 trong tr\u1EADn b\u1EA5m \xF4 v\u0169
      kh\xED \u0111\u1EC3 \u0111\u1ED5i"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358111
    m_Localized: "Ki\u1EBFm \xB7 C\u1EADn chi\u1EBFn \xB7 Rarity"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358112
    m_Localized: "B\u1ECA \u0110\u1ED8NG \xB7 T\u1EF0 K\xCDCH HO\u1EA0T"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358113
    m_Localized: "CH\u1EE6 \u0110\u1ED8NG \xB7 B\u1EA4M TRONG TR\u1EACN"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358114
    m_Localized: "v\u0169 kh\xED trong kho"
    m_Metadata:
      m_Items: []
  - m_Id: 1334358115
    m_Localized: "\u0110\xE3 \u0111\u1EE7 2 m\xF3n c\xF3 k\u1EF9 n\u0103ng k\xEDch
      ho\u1EA1t (t\u1ED1i \u0111a 2 khi v\xE0o tr\u1EADn)."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552320
    m_Localized: "\u0110ANG \u1EDE \xD4 "
    m_Metadata:
      m_Items: []
  - m_Id: 1338552321
    m_Localized: "Trong kho \xB7 so v\u1EDBi \xD4 "
    m_Metadata:
      m_Items: []
  - m_Id: 1338552322
    m_Localized: "V\xC0O \xD4 "
    m_Metadata:
      m_Items: []
  - m_Id: 1338552323
    m_Localized: "\xD4 1 \xB7 c\u1EA7m khi v\xE0o tr\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 1338552324
    m_Localized: "\xD4 2"
    m_Metadata:
      m_Items: []
  - m_Id: 1338552325
    m_Localized: "CH\u1EC8 S\u1ED0 \xD4 "
    m_Metadata:
      m_Items: []
  - m_Id: 1338552326
    m_Localized: "  \u2192  n\u1EBFu \u0111\u1ED5i sang "
    m_Metadata:
      m_Items: []
  - m_Id: 1338552327
    m_Localized: "\u0110\xF2n \u0111\xE1nh thi\xEAu \u0111\u1ED1t qu\xE1i 6 s\xE1t
      th\u01B0\u01A1ng m\u1ED7i gi\xE2y trong 2s."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552328
    m_Localized: "H\u1ECFa Long Tr\u1EA3m \xB7 h\u1ED3i 20s: ch\xE9m m\u1ED9t s\xF3ng
      l\u1EEDa l\u1EDBn ph\xEDa tr\u01B0\u1EDBc."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552329
    m_Localized: "25% t\u1EC9 l\u1EC7 khi \u0111\xE1nh ph\xF3ng tia s\xE9t n\u1EA3y
      sang 3 qu\xE1i."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552330
    m_Localized: "L\xF4i Ph\u1EA1t \xB7 h\u1ED3i 18s: g\u1ECDi 5 tia s\xE9t xu\u1ED1ng
      qu\xE1i g\u1EA7n nh\u1EA5t."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552331
    m_Localized: "T\u0103ng +15% S\xE1t th\u01B0\u01A1ng v\xE0 +10% T\u1ED1c \u0111\xE1nh
      khi c\u1EA7m."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552332
    m_Localized: "X\xE9 Kh\xF4ng Gian \xB7 h\u1ED3i 15s: l\u01B0\u1EDBt xuy\xEAn
      qua qu\xE1i v\xE0 ch\xE9m 2 l\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552333
    m_Localized: "H\u1EA1 qu\xE1i h\u1ED3i 4 Mana."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552334
    m_Localized: "\u0110\xF2n ch\xE9m thi\xEAu \u0111\u1ED1t qu\xE1i 5 s\xE1t th\u01B0\u01A1ng
      m\u1ED7i gi\xE2y trong 2s."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552335
    m_Localized: "\u0110\xF2n ch\xE9m l\xE0m ch\u1EADm qu\xE1i 30% trong 1s."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552336
    m_Localized: "B\u0103ng Tr\u1EADn \xB7 h\u1ED3i 16s: \u0111\xF3ng b\u0103ng qu\xE1i
      xung quanh 2s."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552337
    m_Localized: "T\u0103ng +8% Ch\xED m\u1EA1ng v\xE0 +10% S\xE1t th\u01B0\u01A1ng
      khi c\u1EA7m."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552338
    m_Localized: "H\xFAt m\xE1u khi \u0111\xE1nh tr\xFAng, h\u1ED3i 1 M\xE1u m\u1ED7i
      20 s\xE1t th\u01B0\u01A1ng g\xE2y ra."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552339
    m_Localized: "Th\xE1nh Quang \xB7 h\u1ED3i 25s: h\u1ED3i 2 M\xE1u."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552340
    m_Localized: "H\u1EA1 qu\xE1i h\u1ED3i 5 Mana."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552341
    m_Localized: "G\xE2y \u0111\u1ED9c 4 s\xE1t th\u01B0\u01A1ng m\u1ED7i gi\xE2y
      trong 3s."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552342
    m_Localized: "Kh\xF4ng c\xF3. V\u0169 kh\xED kh\u1EDFi \u0111\u1EA7u c\u1EE7a
      Knight."
    m_Metadata:
      m_Items: []
  - m_Id: 1338552343
