  - m_Id: 59313570230272
    m_Localized: "V\xC0O \xD4 2"
    m_Metadata:
      m_Items: []
  - m_Id: 59313570230273
    m_Localized: "\u0110\xF3ng c\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 284786690666496
    m_Localized: "Hi\u1EC7p S\u0129"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775360
    m_Localized: "Th\xE1nh K\u1EF5 S\u0129"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775361
    m_Localized: "X\u1EA1 Th\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775362
    m_Localized: "Ph\xE1p S\u01B0"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775363
    m_Localized: "\u0110\u1EA1o T\u1EB7c"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775364
    m_Localized: "Tu S\u0129"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775365
    m_Localized: "\u0110\xE1nh g\u1EADy, h\u1ED3i m\xE1u cho b\u1EA3n th\xE2n."
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775366
    m_Localized: "Th\u01B0\u01A1ng Binh"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775367
    m_Localized: "Gi\xE1o d\xE0i, gi\xE1p v\u1EEFng, \u0111\u1EA9y l\xF9i qu\xE1i."
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775368
    m_Localized: "Th\u1EE3 S\u0103n"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775369
    m_Localized: "B\u1EABy v\xE0 dao g\u0103m, \u0111\xE1nh m\u1EA1nh h\u01A1n qu\xE1i
      \u0111ang y\u1EBFu."
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775370
    m_Localized: "Chi\xEAu H\u1ED3n S\u01B0"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775371
    m_Localized: "G\u1ECDi x\u01B0\u01A1ng chi\u1EBFn \u0111\u1EA5u c\xF9ng, th\xE2n
      th\u1EC3 y\u1EBFu."
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775372
    m_Localized: "Oan H\u1ED3n B\u0103ng"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775373
    m_Localized: "Linh h\u1ED3n l\u01A1 l\u1EEDng, \u0111\xF3ng b\u0103ng m\u1ECDi
      th\u1EE9 ch\u1EA1m v\xE0o."
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775374
    m_Localized: "Cu\u1ED3ng Chi\u1EBFn Binh"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775375
    m_Localized: "C\xE0ng \xEDt m\xE1u c\xE0ng \u0111\xE1nh m\u1EA1nh, gi\xE1p m\u1ECFng."
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775376
    m_Localized: "Hi\u1EC7p S\u0129 B\xF3ng T\u1ED1i"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775377
    m_Localized: "L\u01B0\u1EE1i ki\u1EBFm b\xF3ng t\u1ED1i, ch\xED m\u1EA1ng h\xFAt
      m\xE1u."
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775378
    m_Localized: "CH\u01AFA RA M\u1EAET"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775379
    m_Localized: "Nh\xE2n v\u1EADt \u0111ang \u0111\u01B0\u1EE3c ph\xE1t tri\u1EC3n,
      s\u1EBD c\xF3 trong b\u1EA3n c\u1EADp nh\u1EADt sau."
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775380
    m_Localized: "Song Ki\u1EBFm"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775381
    m_Localized: "L\u1ED9n N\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775382
    m_Localized: "H\u1ECFa Long Tr\u1EA3m"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775383
    m_Localized: "L\xF4i Ph\u1EA1t"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775384
    m_Localized: "X\xE9 Kh\xF4ng Gian"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775385
    m_Localized: "Gi\u01A1 Khi\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775386
    m_Localized: "L\xEDnh Gi\xE1o X\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775387
    m_Localized: "Chi\u1EBFn Binh X\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775388
    m_Localized: "X\xE1c S\u1ED1ng"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775389
    m_Localized: "Ma C\xE0 R\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775390
    m_Localized: "\u0110\u1EA7u L\xE2u Bay"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775391
    m_Localized: "Chi\u1EBFn Binh X\u01B0\u01A1ng Tinh Nhu\u1EC7"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775392
    m_Localized: "Ma C\xE0 R\u1ED3ng L\xE3o Luy\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 284786757775393
    m_Localized: "Ch\xFAa T\u1EC3 Ma C\xE0 R\u1ED3ng"
    m_Metadata:
      m_Items: []
  - m_Id: 301041187336192
    m_Localized: "S\xFAng L\u1EE5c Ph\xE9p"
    m_Metadata:
      m_Items: []
  - m_Id: 301041258639360
    m_Localized: "S\xFAng Tr\u01B0\u1EDDng Plasma"
    m_Metadata:
      m_Items: []
  - m_Id: 301041258639361
    m_Localized: "S\xFAng Hoa C\u1EA3i \u0110i\u1EC7n"
    m_Metadata:
      m_Items: []
  - m_Id: 301041258639362
    m_Localized: "S\xFAng Ph\xF3ng T\xEAn L\u1EEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 301041258639363
    m_Localized: "B\u1EAFn \u0111\u1EA1n ph\xE9p \u1ED5n \u0111\u1ECBnh. T\u1ED1n
      \xEDt Mana."
    m_Metadata:
      m_Items: []
  - m_Id: 301041258639364
    m_Localized: "B\u1EAFn plasma li\xEAn thanh. T\u0103ng +10% Ch\xED m\u1EA1ng
      khi c\u1EA7m."
    m_Metadata:
      m_Items: []
  - m_Id: 301041258639365
    m_Localized: "B\u1EAFn ch\xF9m 5 tia \u0111i\u1EC7n s\xE1t th\u01B0\u01A1ng di\u1EC7n
      r\u1ED9ng t\u1EA7m g\u1EA7n."
    m_Metadata:
      m_Items: []
  - m_Id: 301041258639366
    m_Localized: "B\u1EAFn t\xEAn l\u1EEDa h\u1EA1ng n\u1EB7ng ph\xE1t n\u1ED5 b\xE1n
      k\xEDnh 2.2m."
    m_Metadata:
      m_Items: []
  - m_Id: 359145291689984
    m_Localized: "Ch\u1EA1m \u0111\u1EC3 m\u1EDF r\u01B0\u01A1ng"
    m_Metadata:
      m_Items: []
